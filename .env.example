# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
NEON_DB_NAME=your_db_name
NEON_DB_USER=your_db_user
NEON_DB_PASSWORD=your_db_password
NEON_DB_HOST=your_neon_host.neon.tech
NEON_DB_PORT=5432

# ── Django Core ────────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# ── Encryption Key (for stored API keys) ──────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# ── Google OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SITE_URL=https://yourdomain.com

# ── Pinecone (Infinsight RAG) ──────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index

# ── AI Model Fallback Keys (HuggingFace) ───────────────────────────────────
HF_TOKEN_1=your-huggingface-token-1
HF_TOKEN_2=your-huggingface-token-2
HF_TOKEN_3=your-huggingface-token-3

# ── AI Model Primary Keys (Gemini) ─────────────────────────────────────────
Gemini_K1=your-gemini-key-1
Gemini_K2=your-gemini-key-2

# ── AI Model Fallback Keys (Groq) ──────────────────────────────────────────
Groq_1=your-groq-key-1
Groq_2=your-groq-key-2